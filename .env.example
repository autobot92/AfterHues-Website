# AfterHues Studio — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─────────────────────────────────────────────────────────────
# CONTACT FORM — Web3Forms (https://web3forms.com)
# ─────────────────────────────────────────────────────────────
# The website uses Web3Forms to deliver contact form submissions
# to clrnode@gmail.com without needing a backend server.
#
# HOW TO GET YOUR FREE ACCESS KEY:
# 1. Go to https://web3forms.com
# 2. Enter your email address: clrnode@gmail.com
# 3. Click "Create Access Key"
# 4. Check your inbox for a confirmation email and click the link
# 5. Copy the access key and paste it below
#
# IMPORTANT: The NEXT_PUBLIC_ prefix is intentional and required.
# Web3Forms access keys are designed to be safe to expose
# client-side — they are rate-limited and domain-restricted.
#
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ─────────────────────────────────────────────────────────────
# SITE URL (used in sitemap & metadata)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://afterhues.com
